menuconfig RAW_HTTP_SERVER
	bool "Raw HTTP file server (no network stack)"
	select CPP
	select FILE_SYSTEM
	select NETWORKING
	select HTTP_PARSER
	help
	  Serve file downloads and uploads over HTTP/1.1 on bare data buffers
	  - a UART, a USB endpoint, shared memory - with no sockets, L2, IP
	  or TCP in the image.

	  NETWORKING is selected only because the HTTP request parser
	  library's Kconfig lives under it. The heavy parts (native IP stack,
	  Ethernet L2, drivers) are defaulted off at the bottom of this file
	  and stay off unless the application explicitly re-enables them.

if RAW_HTTP_SERVER

config RAW_HTTP_FILES_PREFIX
	string "URL prefix files are served under"
	default "/files/"
	help
	  Requests outside this prefix are answered with 404.

config RAW_HTTP_URL_MAX
	int "Longest accepted URL, query string included"
	default 160
	help
	  Longer requests are answered with 414 URI Too Long rather than
	  silently truncated. Costs this many bytes per server instance.

config RAW_HTTP_PATH_MAX
	int "Longest absolute filesystem path built from a URL"
	default 128
	help
	  fs root plus filename must fit, or the request is answered with
	  404 (uploads) / 414 semantics via -ENAMETOOLONG internally.

config RAW_HTTP_FILE_CHUNK
	int "Bytes read from the filesystem per output callback"
	default 1600
	help
	  A pure throughput-vs-RAM tradeoff costing exactly this many bytes
	  per server instance. Uploads do not use this buffer - body
	  fragments are written to the file straight from the input buffer.

module = RAW_HTTP
module-str = raw_http
source "subsys/logging/Kconfig.template.log_config"

endif # RAW_HTTP_SERVER

# Module Kconfig files are sourced before the subsystem tree, and the first
# satisfied default wins - so this outranks the "default y" on NET_NATIVE in
# subsys/net and keeps the IP stack, packet pools and connection tracking out
# of the image. It is only a default: an application that also wants real
# networking simply sets CONFIG_NET_NATIVE=y in its prj.conf.
#
# Board Kconfig.defconfig files are sourced even earlier and deliberately
# outrank module defaults, so a board that switches its network driver on by
# itself (native_sim does, via NET_L2_ETHERNET) still needs an explicit =n in
# the application - see this sample's prj.conf.
configdefault NET_NATIVE
	default n if RAW_HTTP_SERVER
